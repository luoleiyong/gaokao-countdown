{
  "name": "gaokao-countdown",
  "version": "1.7.3",
  "description": "高考倒计时",
  "main": "main.js",
  "author": {
    "name": "作者：luo"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.trae.gaokao.countdown",
    "productName": "高考倒计时",
    "compression": "normal",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "GaokaoCountdown-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "高考倒计时",
      "license": "build/license.txt",
      "artifactName": "GaokaoCountdown-Setup-${version}.${ext}",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}

{
  "name": "gaokao-countdown",
  "version": "3.0.0",
  "description": "高考倒计时",
  "main": "main.js",
  "author": {
    "name": "作者：luo"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable nsis",
    "build:official": "node scripts/build-official.js dist30",
    "verify": "electron scripts/verify-assets.js",
    "verify:fast": "electron scripts/verify-assets.js --fast"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.trae.gaokao.countdown",
    "productName": "高考倒计时",
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "build/icon.png",
      "!node_modules/**/{test,tests,__tests__,example,examples,doc,docs,types,typings,man}/**",
      "!node_modules/**/*.{md,map,ts,flow,png,jpg,gif,svg}",
      "!node_modules/**/*.min.js",
      "!node_modules/codepage/bits/**",
      "!node_modules/codepage/dist/**",
      "!node_modules/xlsx/dist/xlsx.*",
      "!node_modules/xlsx/dist/cpexcel.full.*",
      "!node_modules/xlsx/xlsx.mjs",
      "!node_modules/xlsx/xlsxworker.js",
      "!node_modules/cfb/dist/**"
    ],
    "asarUnpack": [
      "assets/bg/**"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "GaokaoCountdown-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "高考倒计时",
      "license": "build/license.txt",
      "include": "build/installer.nsh",
      "artifactName": "GaokaoCountdown-Setup-${version}.${ext}",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
